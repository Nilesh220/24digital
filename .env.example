# Production Domain
NEXT_PUBLIC_SITE_URL=https://24digital.store

# Resend Email Configuration (for contact form submissions)
# 1. Sign up at https://resend.com and create an API key
# 2. Add RESEND_API_KEY in your Vercel Project Environment Variables
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=24digital Inquiries <onboarding@resend.dev>
RESEND_TO_EMAIL=support@24digital.store

